# Ops Console — environment variables
# Copy to .env and fill in values for your environment

# Base URL for the backend API
# e.g. http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# Set to true to use mock data instead of real API calls (default: true)
VITE_USE_MOCK=true

# Role to use in mock mode — admin | supervisor | operator (default: admin)
VITE_MOCK_ROLE=admin

# Set to true to use Server-Sent Events for live data instead of polling (default: false)
VITE_USE_SSE=false

# Plant identifier used in API requests (e.g. plant-001)
VITE_PLANT_ID=plant-001
