# Floor Console — environment variables
# Copy to .env and fill in values for your environment

# Gateway base URL (required — set to your Gateway address)
VITE_API_BASE_URL=http://localhost:8000

# Set to true to use mock data instead of live API (default: true)
VITE_USE_MOCK=true

# Plant identifier for this Andon terminal
VITE_PLANT_ID=hsl_ludhiana

# Device identity (set per Andon terminal)
VITE_DEVICE_ID=andon_crs2
VITE_WC_ID=CRS-2

# Auth
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=zedral
VITE_KEYCLOAK_CLIENT_ID=zedral-spa
