{
  "realm": "zedral",
  "enabled": true,
  "displayName": "Zedral MES",
  "sslRequired": "NONE",
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Full administrative access to all modules"
      },
      {
        "name": "supervisor",
        "description": "Supervisor access — can approve, override, and view all data"
      },
      {
        "name": "operator",
        "description": "Operator access — can view and update assigned work orders"
      }
    ]
  },
  "clients": [
    {
      "clientId": "zedral-spa",
      "enabled": true,
      "publicClient": true,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:5174/*",
        "https://ops.zedral.com/*",
        "https://floor.zedral.com/*",
        "http://136.111.39.179:8000/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:5174",
        "https://ops.zedral.com",
        "https://floor.zedral.com",
        "http://136.111.39.179:8000"
      ],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "admin" }],
      "realmRoles": ["admin"]
    },
    {
      "username": "supervisor",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "supervisor" }],
      "realmRoles": ["supervisor"]
    },
    {
      "username": "operator",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "operator" }],
      "realmRoles": ["operator"]
    }
  ]
}
