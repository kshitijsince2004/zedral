# Zedral Infrastructure — Environment Variables
# Copy to .env: cp infra/.env.example infra/.env

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=zedral
POSTGRES_PASSWORD=zedral_dev_password
POSTGRES_DB=zedral

# ── Keycloak ────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password

# ── Redpanda ────────────────────────────────────────────────
# No credentials needed in dev mode (SASL disabled)
# In production: set REDPANDA_SASL_USERNAME and REDPANDA_SASL_PASSWORD

# ── Backend Services ────────────────────────────────────────
# Shared across all services
PLANT_ID=hsl_ludhiana
EVENT_SIGNING_SECRET=dev-secret-change-in-production

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Auth ────────────────────────────────────────────────────
# Set to "false" in production to enforce JWT validation
AUTH_DISABLED=false
